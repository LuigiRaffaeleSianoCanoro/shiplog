# --- Required for production (Vercel + Origin) ---
# Origin App credentials from https://cursor.com/codebase/settings/apps
ORIGIN_APP_ID=
# PEM private key (paste multiline in Vercel, or use \n in one line)
ORIGIN_APP_PRIVATE_KEY=
# 32-byte master key, base64: openssl rand -base64 32
SHIPLOG_KEY_ENC=
# Canonical public URL of this deployment (no trailing slash). Must match Origin installationRedirectUris.
SHIPLOG_INSTALL_ORIGIN=
# Protects GET /api/cron/poll — send Authorization: Bearer <value>
CRON_SECRET=

# --- AI mode ---
# Production default: launch Cursor cloud agents on the installer's key. Set "neon" for operator test mode.
SHIPLOG_LLM_PROVIDER=cursor
# "false" = keyless / prompt-only mode (US$0 LLM cost). "true" = BYOK setup on /setup (default).
SHIPLOG_BYOK_ENABLED=true

# --- Vercel Blob (production storage) ---
# Injected automatically when you connect a private Blob store to the Vercel project. Do not set manually on Vercel.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# --- Optional: Supabase instead of Blob ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Neon test mode only (SHIPLOG_LLM_PROVIDER=neon) ---
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
SHIPLOG_NEON_MODEL=claude-opus-5-5

# --- Optional overrides ---
ORIGIN_API_BASE=
CURSOR_API_BASE=
ORIGIN_JWKS_URL=
# Gate the all-installations dashboard (?token= or Bearer)
SHIPLOG_DASHBOARD_TOKEN=

# --- Local development only ---
# JSON file store when not on Vercel and Blob is unset (default .data/shiplog.json)
SHIPLOG_DATA_FILE=
# Skip webhook signatures when NODE_ENV is not production. Never enable on Vercel production.
SHIPLOG_INSECURE_WEBHOOKS=

# --- Platform (documented; do not set on Vercel) ---
# NODE_ENV=production
# VERCEL=1
