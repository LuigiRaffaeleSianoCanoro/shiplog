# Production default: launch Cursor cloud agents on the installer's key. Set "neon" for test mode.
SHIPLOG_LLM_PROVIDER=cursor
# BYOK key collection flag (FAB-80 pending Cursor's reply). "false" = prompt-only mode.
SHIPLOG_BYOK_ENABLED=true
# 32-byte master key, base64: openssl rand -base64 32
SHIPLOG_KEY_ENC=
# Origin App credentials
ORIGIN_APP_ID=
ORIGIN_APP_PRIVATE_KEY=
# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Test mode only
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
SHIPLOG_NEON_MODEL=claude-opus-5-5
# Optional: gate the all-installations dashboard view
SHIPLOG_DASHBOARD_TOKEN=
# Required in production: protects GET /api/cron/poll (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=
# Optional: overlap guard TTL for concurrent poll requests (default 90000 ms)
# CRON_POLL_LOCK_TTL_MS=90000
